# Copy to `.env` at the repo root. The worker and db scripts load it with Node's `--env-file`
# flag; Next only reads env from its own directory, so `apps/web/.env` is a symlink to this file
# (created in Local setup). There is no dotenv dependency.
# Every variable is validated with zod at boot (packages/shared/src/env.ts); a missing or
# malformed value fails the process with a readable message instead of a runtime surprise.

# ---------------------------------------------------------------- M0: both apps
# Postgres. Local: docker-compose.yml. Production: Neon *pooled* connection string.
DATABASE_URL=postgresql://auditor:auditor@localhost:5433/auditor
# Redis. Local: docker-compose.yml. Production: Railway Redis (private URL for the worker,
# TCP-proxy URL for Vercel).
REDIS_URL=redis://localhost:6380
# debug | info | warn | error
LOG_LEVEL=info
# The worker's health server port. Railway injects PORT itself; leave unset locally (8080).
# PORT=8080

# ---------------------------------------------------------------- M3: postback receiver
# SHOPIFY_WEBHOOK_SECRET=
# POSTBACK_HMAC_SECRET=

# ---------------------------------------------------------------- M3/M7: conversion sender, reconciliation
# SHOPIFY_STORE_DOMAIN=
# SHOPIFY_ADMIN_TOKEN=
# META_PIXEL_ID=
# META_CAPI_TOKEN=

# ---------------------------------------------------------------- M8: alerting
# ALERT_WEBHOOK_URL=
