# Copy to `.env` at the repo root. The worker and db scripts load it with Node's `--env-file`
# flag; Next only reads env from its own directory, so `apps/web/.env` is a symlink to this file
# (created in Local setup). There is no dotenv dependency.
# Every variable is validated with zod at boot (packages/shared/src/env.ts); a missing or
# malformed value fails the process with a readable message instead of a runtime surprise.

# ---------------------------------------------------------------- M0: both apps
# Postgres. Local: docker-compose.yml. Production: Neon *pooled* connection string.
DATABASE_URL=postgresql://auditor:auditor@localhost:5433/auditor
# Redis. Local: docker-compose.yml. Production: Railway Redis (private URL for the worker,
# TCP-proxy URL for Vercel).
REDIS_URL=redis://localhost:6380
# debug | info | warn | error
LOG_LEVEL=info
# The worker's health server port: WORKER_PORT, else PORT (Railway injects PORT), else 8080.
# Set WORKER_PORT locally if 8080 is taken; do not set PORT here, Next.js honours it too.
# WORKER_PORT=8090

# ---------------------------------------------------------------- M2: advertorial + /go redirect (web)
# Hostname only. Where the advertorial's CTA redirects to.
SHOPIFY_STORE_DOMAIN=auditor-demo.myshopify.com
# The Meta Pixel / dataset ID the advertorial page fires. Same one the store's snippet uses.
META_PIXEL_ID=1541349738037398

# ---------------------------------------------------------------- M3: postback receiver, Shopify webhook, conversion sender (web)
# Verifies incoming postbacks; our sender signs with it too. Generate: openssl rand -hex 32
POSTBACK_HMAC_SECRET=replace-me-with-openssl-rand-hex-32-output-000000000000
# Shown by Shopify when creating the orders/create webhook (Settings → Notifications → Webhooks).
SHOPIFY_WEBHOOK_SECRET=replace-me-with-the-shopify-signing-secret
# Conversions API access token (Events Manager → dataset → Settings → Conversions API).
META_CAPI_TOKEN=replace-me-with-the-capi-token
# Optional: Events Manager → Test events code, so server-side events show up in that tool.
# META_TEST_EVENT_CODE=TEST12345

# ---------------------------------------------------------------- M7: reconciliation
# SHOPIFY_ADMIN_TOKEN=

# ---------------------------------------------------------------- M8: alerting
# ALERT_WEBHOOK_URL=
